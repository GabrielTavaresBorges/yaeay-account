{
  "EmailConfirmationLink": {
    "ConfirmationPageUrl": "https://localhost:57930/confirm-email"
  },
  "DocumentImageStorage": {
    "Provider": "LocalFileSystem",
    "Enabled": true,
    "LocalRootPath": "../../../../ambiente-local"
  },
  "Scheduling": {
    "OutboxProcessing": {
      "IsActive": true,
      "IntervalInSeconds": 1,
      "BatchSize": 20,
      "RetryDelayInSeconds": 1
    }
  },
  "UserInterface": {
    "ShowTestModeBanner": true,
    "TestModeBannerText": "MODO DE TESTES - HOMOLOGAÇÃO"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
