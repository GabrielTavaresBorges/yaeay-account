{
  "EmailConfirmationPolicy": {
    "InitialStageEndsAfterMonths": 3
  },
  "Scheduling": {
    "OutboxProcessing": {
      "IsActive": false,
      "IntervalInSeconds": 30,
      "BatchSize": 20,
      "RetryDelayInSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
