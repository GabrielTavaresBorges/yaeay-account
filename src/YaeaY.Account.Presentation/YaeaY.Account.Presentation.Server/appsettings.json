{
  "Authentication": {
    "Session": {
      "IdleTimeoutInMinutes": 30,
      "RememberMeDurationInDays": 14,
      "SecurityStampValidationIntervalInMinutes": 5,
      "MaxFailedAccessAttempts": 5,
      "LockoutDurationInMinutes": 15
    }
  },
  "EmailConfirmationPolicy": {
    "InitialStageEndsAfterMonths": 3
  },
  "Scheduling": {
    "OutboxProcessing": {
      "IsActive": false,
      "IntervalInSeconds": 30,
      "BatchSize": 20,
      "RetryDelayInSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
