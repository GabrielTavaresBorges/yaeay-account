{
  "Authentication": {
    "Session": {
      "IdleTimeoutInMinutes": 30,
      "RememberMeDurationInDays": 14,
      "SecurityStampValidationIntervalInMinutes": 5,
      "MaxFailedAccessAttempts": 5,
      "LockoutDurationInMinutes": 15
    }
  },
  "EmailConfirmationPolicy": {
    "InitialStageEndsAfterMonths": 3
  },
  "PasswordRecovery": {
    "CodeLifetimeInMinutes": 2,
    "ResetAuthorizationLifetimeInMinutes": 10,
    "ResendIntervalInSeconds": 120,
    "RequestWindowInMinutes": 60,
    "MaximumFailedAttempts": 5,
    "MaximumRequestsPerWindow": 5
  },
  "Scheduling": {
    "OutboxProcessing": {
      "IsActive": false,
      "IntervalInSeconds": 30,
      "BatchSize": 20,
      "RetryDelayInSeconds": 60
    }
  },
  "UserInterface": {
    "ShowTestModeBanner": false,
    "TestModeBannerText": "MODO DE TESTES - HOMOLOGAÇÃO"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
