# Copy this file to .env on the VM. Never commit the populated .env file.
# One file and one database per environment: Stage or Production.

COMPOSE_PROJECT_NAME=account-stage
ACCOUNT_IMAGE_PREFIX=yaeay/account-stage
RELEASE_VERSION=replace-with-commit-sha
ACCOUNT_PUBLIC_HOST=account-stage.yaeay.com
SHARED_INFRASTRUCTURE_NETWORK=yaeay_network
ASPNETCORE_ENVIRONMENT=Staging

# The host must be the database container reachable from the shared Docker network.
ConnectionStrings__DefaultConnection=Host=postgres-stage;Port=5432;Database=Account;Username=replace;Password=replace
ConnectionStrings__ReadConnection=Host=postgres-stage;Port=5432;Database=Account;Username=replace;Password=replace

Scheduling__OutboxProcessing__IsActive=true
Scheduling__OutboxProcessing__IntervalInSeconds=30
Scheduling__OutboxProcessing__BatchSize=20
Scheduling__OutboxProcessing__RetryDelayInSeconds=60

Messaging__RabbitMq__Enabled=true
Messaging__RabbitMq__HostName=rabbitmq
Messaging__RabbitMq__Port=5672
Messaging__RabbitMq__VirtualHost=/
Messaging__RabbitMq__UserName=replace-with-rabbit-user
Messaging__RabbitMq__Password=replace-with-rabbit-password
Messaging__RabbitMq__ExchangeName=account.events
Messaging__RabbitMq__ReadModelQueueName=account.read-model
Messaging__RabbitMq__DeadLetterExchangeName=account.dead-letter
Messaging__RabbitMq__ReadModelDeadLetterQueueName=account.read-model.dead-letter
Messaging__RabbitMq__ReadModelDeadLetterRoutingKey=account.read-model.failed.v1

ReadModels__Rebuild__RebuildMyDataOnStartup=false
ReadModels__Rebuild__RebuildAdministrationOnStartup=false

EmailConfirmationLink__ConfirmationPageUrl=https://account-stage.yaeay.com/confirm-email
EmailDelivery__Smtp__IsActive=true
EmailDelivery__Smtp__Host=replace-with-smtp-host
EmailDelivery__Smtp__Port=587
EmailDelivery__Smtp__SecurityMode=StartTls
EmailDelivery__Smtp__Username=replace-with-smtp-user
EmailDelivery__Smtp__Password=replace-with-smtp-password
EmailDelivery__Smtp__TimeoutInSeconds=30
